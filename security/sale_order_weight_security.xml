<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security group for weight management (optional - currently all sales users can view) -->
        <!-- You can create custom group if needed -->
        
        <!-- Record rule example: managers can see all heavy orders, salespeople only their own -->
        <record id="sale_order_weight_salesman_rule" model="ir.rule">
            <field name="name">Salesman: Own Heavy Orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[
                '|',
                    ('is_heavy_order', '=', False),
                    ('user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Managers can see all heavy orders -->
        <record id="sale_order_weight_manager_rule" model="ir.rule">
            <field name="name">Manager: All Heavy Orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>